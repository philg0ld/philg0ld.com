---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Tag cloud with counts, sorted by count desc then name asc.
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const topics = [...tagCounts.entries()].sort((a, b) =>
	b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE}'s blog posts - ${SITE_TITLE}'s Website`} description={SITE_DESCRIPTION} />
		<style>
			.topics ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em 0.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			{topics.length > 0 && (
				<section class="topics">
					<h2 class="eyebrow">Topics</h2>
					<ul>
						{topics.map(([tag, count]) => (
							<li>
								<a class="tag-pill" href={`/search/?q=${encodeURIComponent(tag)}`}>
									{tag} <span class="count">{count}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<h2 class="eyebrow">Writing</h2>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>
