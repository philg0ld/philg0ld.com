---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareButtons from '../components/ShareButtons.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug: string };

const { title, description, pubDate, updatedDate, heroImage, tags, slug } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 0;
			}
			.prose {
				width: var(--prose-max-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--color-ink);
			}
			.title {
				margin-bottom: 1.5em;
			}
			.title h1 {
				margin: 0 0 0.25em 0;
			}
			.date {
				color: var(--color-muted);
				font-size: 0.95em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				margin-top: 3em;
				padding-top: 1em;
				border-top: 1px solid var(--color-rule);
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em 0.75em;
			}
			.tag {
				display: inline-block;
				color: var(--color-muted);
				font-size: 0.9em;
			}
			.related-wrapper {
				width: var(--prose-max-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										&middot; Last updated on <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
					</div>
					<slot />
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((tag) => <span class="tag">#{tag}</span>)}
						</div>
					)}
				</div>
			</article>
			<ShareButtons url={url} title={title} />
			<div class="related-wrapper">
				<RelatedPosts currentSlug={slug} currentTags={tags ?? []} />
			</div>
		</main>
		<Footer />
		<script is:inline>
			(() => {
				const anchors = document.querySelectorAll('.heading-anchor');
				anchors.forEach((a) => {
					a.addEventListener('click', (e) => {
						e.preventDefault();
						const href = a.getAttribute('href') || '';
						const url =
							window.location.origin + window.location.pathname + href;
						const reset = () => {
							a.classList.remove('copied');
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(url).then(
								() => {
									a.classList.add('copied');
									setTimeout(reset, 1500);
								},
								() => {},
							);
						} else {
							const t = document.createElement('textarea');
							t.value = url;
							document.body.appendChild(t);
							t.select();
							try { document.execCommand('copy'); } catch (_) {}
							document.body.removeChild(t);
							a.classList.add('copied');
							setTimeout(reset, 1500);
						}
					});
				});
			})();
		</script>
	</body>
</html>
