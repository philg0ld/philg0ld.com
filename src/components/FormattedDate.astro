---
interface Props {
	date: Date;
	format?: 'long' | 'year-month';
}

const { date, format = 'long' } = Astro.props;

const display =
	format === 'year-month'
		? date.toISOString().slice(0, 7)
		: date.toLocaleDateString('en-us', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			});
---

<time datetime={date.toISOString()}>{display}</time>
