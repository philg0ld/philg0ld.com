---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<span class="date">
						<FormattedDate date={post.data.pubDate} format="year-month" />
					</span>
					<span class="title">{post.data.title}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul.post-list li {
		padding: 0.15em 0;
	}
	ul.post-list a {
		display: flex;
		align-items: baseline;
		gap: 1em;
		color: var(--color-ink);
		text-decoration: none;
	}
	ul.post-list a:hover .title {
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	ul.post-list .date {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.9em;
		min-width: 5.5em;
		flex-shrink: 0;
	}
	ul.post-list .title {
		color: var(--color-ink);
	}
	@media (max-width: 480px) {
		ul.post-list a {
			flex-wrap: wrap;
			gap: 0.25em 0.75em;
		}
		ul.post-list .date {
			min-width: 0;
		}
	}
</style>
